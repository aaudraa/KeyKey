# Satır sonları repoda ve çalışma klasöründe LF; yalnızca Windows betikleri CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.keykey binary

# İçe aktarma örnekleri bayt bayt korunur; Chrome örneği CRLF kullanıyor.
test/fixtures/import/logins/*.csv -text

# Dışarıdan alınan kaynaklar bayt bayt korunur, özetleri kaynağıyla
# karşılaştırılabilsin. Fark gösterilmez, GitHub dil istatistiğine girmez.
android/third_party/** -text -diff linguist-vendored
