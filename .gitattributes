# Satır sonları repoda ve çalışma klasöründe LF; yalnızca Windows betikleri CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.keykey binary
