  "termsTitle": "Terms of use",
  "@termsTitle": {
    "description": "Title of the terms of use screen and its settings row."
  },
  "termsIntro": "Please read this before you start using KeyKey. We kept it short; every point describes how KeyKey actually works.",
  "@termsIntro": {
    "description": "Terms: opening paragraph."
  },
  "termsDataTitle": "Your data is in your hands",
  "@termsDataTitle": {
    "description": "Terms section title: where data lives."
  },
  "termsDataBody": "Your passwords, 2FA accounts, cards and notes are kept in the vault on this phone. A backup or export file is only created when you ask for it, and saved where you choose. KeyKey has no account and no server, shows no ads and collects no usage data. It goes online only for features you turn on yourself: the breach check in the password report (your passwords themselves are never sent) and, if you turn it on, sync. When you open a link, the page opens in your browser. The developers cannot see, collect or store your data.",
  "@termsDataBody": {
    "description": "Terms section body: where data lives."
  },
  "termsCryptoTitle": "How the vault is protected",
  "@termsCryptoTitle": {
    "description": "Terms section title: encryption."
  },
  "termsCryptoBody": "The vault is protected by a key derived from your master password with Argon2id; entries are encrypted with XChaCha20-Poly1305. Your master password is never stored. If you turn on fingerprint unlock, the vault key is protected by a key kept in the phone's secure hardware (Android Keystore).",
  "@termsCryptoBody": {
    "description": "Terms section body: encryption."
  },
  "termsSecretsTitle": "Only you hold the master password and recovery key",
  "@termsSecretsTitle": {
    "description": "Terms section title: master password and recovery key."
  },
  "termsSecretsBody": "Only you know your master password and recovery key. If you lose both, your vault cannot be opened; no one, including the developers, can recover your data. Don't share either of them: KeyKey will never ask for your master password by email or message.",
  "@termsSecretsBody": {
    "description": "Terms section body: master password and recovery key."
  },
  "termsBackupTitle": "Backups are up to you",
  "@termsBackupTitle": {
    "description": "Terms section title: backups."
  },
  "termsBackupBody": "If the phone is lost or broken, or KeyKey is uninstalled, the vault is gone too. Taking regular encrypted backups and keeping them somewhere safe is your responsibility. An unencrypted export file is not protected; delete it when you are done.",
  "@termsBackupBody": {
    "description": "Terms section body: backups."
  },
  "termsDeviceTitle": "Your phone's security",
  "@termsDeviceTitle": {
    "description": "Terms section title: device security."
  },
  "termsDeviceBody": "No app can protect your data on a compromised phone. Keep your phone updated and use a screen lock; don't use KeyKey on a rooted phone or alongside apps you don't trust. A copied password is cleared from the clipboard after 30 seconds; until then, apps that can access the clipboard may read it, and some keyboards' clipboard history may keep it longer.",
  "@termsDeviceBody": {
    "description": "Terms section body: device security."
  },
  "termsOpenSourceTitle": "Open source, not independently audited",
  "@termsOpenSourceTitle": {
    "description": "Terms section title: open source and audit status."
  },
  "termsOpenSourceBody": "KeyKey is free and open source (GPL-3.0); anyone can review its code. Most of the code was written with an AI assistant. KeyKey has not yet had an independent security audit.",
  "@termsOpenSourceBody": {
    "description": "Terms section body: open source, AI disclosure, audit status."
  },
  "termsWarrantyTitle": "No warranty",
  "@termsWarrantyTitle": {
    "description": "Terms section title: warranty and liability."
  },
  "termsWarrantyBody": "KeyKey is provided as is, without any warranty. To the extent permitted by applicable law, the developers are not liable for data loss, for your data falling into others' hands, or for any damage arising from using KeyKey. See sections 15 and 16 of the GPL-3.0 license (Settings → About → Licenses).",
  "@termsWarrantyBody": {
    "description": "Terms section body: no warranty, limitation of liability."
  },
