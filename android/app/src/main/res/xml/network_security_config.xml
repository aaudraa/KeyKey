<?xml version="1.0" encoding="utf-8"?>
<!-- Şifresiz (http://) trafik kapalı; yalnızca sistemin güvendiği sertifikalar.
     Kullanıcının eklediği sertifikalara güvenilmez. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
